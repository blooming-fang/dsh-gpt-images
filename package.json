{
  "name": "dsh-gpt-images",
  "version": "0.2.0",
  "description": "把模型已经返回的生图结果自动保存到会话当前目录，并在会话里直接显示",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/bridge.js && node --check src/extract.js && node --check src/capture.js && node --check src/storage.js && node --check src/download.js && node --check src/session.js"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
